# GodsWar settings. setup.sh copies this to config/godswar.env (ignored by git) and fills it in.
# Every address, port and secret used by the scripts comes from here. Nothing is hard-coded.

# Address players type into the client: your VPS public IP or domain, or 127.0.0.1 for this computer only.
GODSWAR_HOST=127.0.0.1

# Ports players connect to (open these in your firewall on a VPS).
GODSWAR_LOGIN_PORT=6999
GODSWAR_GAME_PORT=7000

# Rule set: "reborn" (default) lifts the original game's limits (gear quality 20 / grade 25 instead of 10 / 12);
# "classic" keeps the original limits. See docs/EDITIONS.md. Change it, then restart the server.
GODSWAR_EDITION=reborn

# Database. setup.sh generates a random password.
POSTGRES_DB=godswar
POSTGRES_USER=godswar
POSTGRES_PASSWORD=change-me

# First administrator account (created by setup.sh). Password is generated if left empty.
GODSWAR_ADMIN_USER=admin
GODSWAR_ADMIN_PASSWORD=

# Let anyone create an account by logging in with a new name (true/false). Use the sign-up site instead if you can.
GODSWAR_ALLOW_REGISTRATION=false

# GM / developer chat commands for the administrator account (setup.sh fills in the id and turns this on).
GODSWAR_DEVELOPER_COMMANDS_ENABLED=false
GODSWAR_DEVELOPER_ACCOUNT_IDS=

# Optional web pieces (docs/WEBSITE.md): public domain for sign-up and the editor.
GW_SIGNUP_DOMAIN=
